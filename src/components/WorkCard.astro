---
/**
 * Project card for the home Work list. Phones: mockup stage on top, body below.
 * From 960px: horizontal, the mockup on a lit stage (~58%) beside the body.
 * The H3 link is stretched over the whole card; external links sit above it
 * (position: relative; z-index: 1). The mockup is picked from the slug unless
 * you pass one in the default slot.
 *
 *   {projectCards(locale).map((p) => <WorkCard {...p} locale={locale} />)}
 */
import StatusChip from './StatusChip.astro';
import SpecRows from './SpecRows.astro';
import ExternalLink from './ExternalLink.astro';
import MockupVstats from './mockups/MockupVstats.astro';
import MockupDesktop from './mockups/MockupDesktop.astro';
import MockupTeams from './mockups/MockupTeams.astro';
import MockupIvpiter from './mockups/MockupIvpiter.astro';
import { transitionNames, type ChipData, type ExternalLinkData, type ProjectSlug, type SpecRow } from '../data/projects';
import { useStrings, type Locale } from '../i18n';

interface Props {
  slug: ProjectSlug;
  locale: Locale;
  chips: ChipData[];
  title: string;
  oneLiner: string;
  specRows: SpecRow[];
  external: ExternalLinkData[];
  /** Base-aware case-study href (projectCards() provides it). */
  href: string;
  headingLevel?: 'h3' | 'h2';
  class?: string;
}

const { slug, locale, chips, title, oneLiner, specRows, external, href, headingLevel = 'h3', class: className } =
  Astro.props;
const t = useStrings(locale);
const vt = transitionNames(slug);
const Heading = headingLevel;
const mockups = {
  vstats: MockupVstats,
  'vstats-desktop': MockupDesktop,
  'vstats-teams': MockupTeams,
  ivpiter: MockupIvpiter,
} as const;
const Mockup = mockups[slug];
// Two-tone title: product name in ink, the description after the colon in grey.
const split = title.indexOf(': ');
const name = split > 0 ? title.slice(0, split + 1) : title;
const rest = split > 0 ? title.slice(split + 2) : '';
---

<article class:list={['work-card', 'glow-card', className]} data-glow>
  <div class="work-card__stage">
    <span class="ember" aria-hidden="true"></span>
    <div class="work-card__mockup" style={`view-transition-name: ${vt.mock}`}>
      {Astro.slots.has('default') ? <slot /> : <Mockup locale={locale} />}
    </div>
  </div>
  <div class="work-card__body">
    <ul class="work-card__chips" role="list">
      {chips.map((chip) => <li><StatusChip kind={chip.kind} text={chip.text} /></li>)}
    </ul>
    <Heading class="work-card__title" style={`view-transition-name: ${vt.title}`}>
      <a href={href} class="work-card__link">{name}{rest && <> <span class="work-card__desc">{rest}</span></>}</a>
    </Heading>
    <p class="work-card__text">{oneLiner}</p>
    <SpecRows rows={specRows} size="sm" locale={locale} class="work-card__spec" />
    <p class="work-card__links">
      <span class="work-card__more" aria-hidden="true">{t.work.readCase} <span class="work-card__arrow">→</span></span>
      {
        external.map((link) => (
          <ExternalLink href={link.href} locale={locale} class="work-card__ext">
            {link.label}
          </ExternalLink>
        ))
      }
    </p>
  </div>
</article>

<style>
  .work-card {
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: clamp(var(--r-lg), 4vw, var(--r-xl));
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: border-color var(--dur-2) ease;
  }
  .work-card:is(:hover, :focus-within) { border-color: var(--line-2); }
  .work-card:has(.work-card__link:focus-visible) { outline: 2px solid var(--accent); outline-offset: 4px; }

  /* Stage: a slightly lit panel with an ember glow behind the mockup. */
  .work-card__stage {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    padding: clamp(20px, 3.4vw, 48px);
    background: linear-gradient(rgb(242 239 232 / .045), rgb(242 239 232 / .015));
    border-bottom: 1px solid var(--line);
  }
  .ember {
    inset: 50% auto auto 50%;
    width: 125%;
    translate: -50% -44%;
    opacity: 0.85;
    transition: opacity var(--dur-3), scale var(--dur-3) var(--ease-out);
  }
  .work-card:hover .ember { opacity: 1; scale: 1.06; }
  .work-card__mockup { width: 100%; max-width: 640px; }
  .work-card__mockup > :global(*) { transition: transform var(--dur-3) var(--ease-out); }
  .work-card:is(:hover, :focus-within) .work-card__mockup > :global(*) { transform: translateY(-4px) scale(1.01); }

  /* Centred beside the stage on wide cards (equal heights leave shorter bodies room). */
  .work-card__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--s-4);
    min-width: 0;
    padding: clamp(24px, 3.4vw, 48px) clamp(24px, 3.4vw, 48px) clamp(16px, 2.2vw, 32px);
  }
  .work-card__chips { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .work-card__title { font-size: clamp(1.5rem, 1.1rem + 1vw, 2rem); font-weight: 660; line-height: 1.12; letter-spacing: -0.028em; }
  .work-card__link, .work-card__link:hover { color: var(--ink); text-decoration: none; }
  .work-card__link:focus-visible { outline: none; }
  .work-card__link::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .work-card__desc { color: var(--muted); }
  .work-card__text { font-size: var(--step-0); }
  .work-card__body :global(.work-card__spec) { border-top: 1px solid var(--line); }

  .work-card__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-5);
    min-height: 44px;
    margin-top: var(--s-2);
    font-size: 0.9375rem;
  }
  .work-card__more { color: var(--accent); font-weight: 580; }
  .work-card__arrow { display: inline-block; transition: transform var(--dur-2) var(--ease-out); }
  .work-card:is(:hover, :focus-within) .work-card__arrow { transform: translateX(4px); }
  .work-card__links :global(.work-card__ext) {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    text-decoration: none;
  }
  .work-card__links :global(.work-card__ext:hover) { color: var(--ink); }

  /* Wide: stage left (~58% from 1200px), body right. Height comes from the list (Work.astro). */
  @media (min-width: 960px) {
    .work-card { grid-template: none / minmax(0, 1.1fr) minmax(0, 1fr); }
    .work-card__stage { border: 0; border-right: 1px solid var(--line); }
  }
  @media (min-width: 1200px) {
    .work-card { grid-template-columns: minmax(0, 1.36fr) minmax(0, 1fr); }
  }
</style>
