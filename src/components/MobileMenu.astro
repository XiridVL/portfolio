---
/**
 * Mobile navigation (<960px): a 44px icon trigger (two lines that fold into
 * an ×) plus a full-screen glass <dialog> sheet. Links stagger in on open.
 * Focus is trapped inside while open, Esc closes it (native), and focus
 * returns to the trigger on close. Following a link closes the sheet.
 * Rendered by Header; not meant to be used directly.
 */
import Monogram from './Monogram.astro';
import LangSwitch from './LangSwitch.astro';
import Button from './Button.astro';
import { useStrings, type Locale, type RouteKey } from '../i18n';

interface Props {
  locale: Locale;
  routeKey?: RouteKey;
  items: Array<{ anchor: string; label: string; href: string }>;
  ctaHref: string;
}
const { locale, routeKey, items, ctaHref } = Astro.props;
const t = useStrings(locale);
---

<button
  type="button"
  class="mobile-menu__trigger"
  data-menu-open
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-controls="mobile-menu"
>
  <span class="mobile-menu__icon" aria-hidden="true"></span>
  <span class="visually-hidden">{t.header.menuOpen}</span>
</button>

<dialog id="mobile-menu" class="mobile-menu" aria-label={t.header.menuOpen} data-menu>
  <div class="mobile-menu__top">
    <Monogram variant="lockup" size={26} />
    <button type="button" class="mobile-menu__trigger mobile-menu__close" data-menu-close>
      <span class="mobile-menu__icon" aria-hidden="true"></span>
      <span class="visually-hidden">{t.header.menuClose}</span>
    </button>
  </div>
  <nav aria-label={t.header.navLabel}>
    <ul role="list" class="mobile-menu__list">
      {
        items.map((item, i) => (
          <li style={`--i: ${i}`}>
            <a href={item.href} data-nav-link={item.anchor} data-menu-link>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="mobile-menu__foot" style={`--i: ${items.length}`}>
    <LangSwitch locale={locale} routeKey={routeKey} />
    <Button href={ctaHref} size="lg" arrow="right" class="mobile-menu__cta" data-menu-link>{t.header.cta}</Button>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]');
  const trigger = document.querySelector<HTMLButtonElement>('[data-menu-open]');

  if (dialog && trigger) {
    const focusables = () =>
      Array.from(dialog.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')).filter(
        (el) => el.offsetParent !== null,
      );

    trigger.addEventListener('click', () => {
      dialog.showModal();
      trigger.setAttribute('aria-expanded', 'true');
      document.documentElement.classList.add('has-open-menu');
    });

    let followingLink = false;
    dialog.addEventListener('close', () => {
      trigger.setAttribute('aria-expanded', 'false');
      document.documentElement.classList.remove('has-open-menu');
      // Return focus to the trigger, unless the user followed a link (let the target take over).
      if (!followingLink) trigger.focus();
      followingLink = false;
    });

    dialog.addEventListener('click', (event) => {
      const target = event.target as Element;
      if (target === dialog) dialog.close(); // backdrop click
      if (target.closest('[data-menu-link]')) {
        followingLink = true;
        dialog.close();
      } else if (target.closest('[data-menu-close]')) {
        dialog.close();
      }
    });

    // Keep Tab inside the sheet.
    dialog.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      const items = focusables();
      const first = items[0];
      const last = items[items.length - 1];
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // Close if the viewport grows past the breakpoint while open.
    matchMedia('(min-width: 960px)').addEventListener('change', (e) => {
      if (e.matches && dialog.open) dialog.close();
    });
  }
</script>

<style>
  /* ---- Trigger / close: 44px icon buttons ---- */
  .mobile-menu__trigger {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-inline-end: -10px; /* optically align the lines with the gutter */
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--ink);
    transition: background-color var(--dur-1);
  }
  .mobile-menu__trigger:hover { background: rgb(242 239 232 / .07); }
  @media (min-width: 960px) {
    [data-menu-open] { display: none; }
  }
  /* Two 18px lines, 7px apart; they fold into an × while expanded (--x: 1). */
  .mobile-menu__icon { position: relative; width: 18px; height: 8px; }
  .mobile-menu__icon::before,
  .mobile-menu__icon::after {
    content: "";
    position: absolute;
    inset: calc(50% - 0.75px) 0 auto;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
    transform: translateY(calc((1 - var(--x, 0)) * var(--y))) rotate(calc(var(--x, 0) * var(--r)));
    transition: transform var(--dur-2) var(--ease-out);
  }
  .mobile-menu__icon::before { --y: -3.5px; --r: 45deg; }
  .mobile-menu__icon::after { --y: 3.5px; --r: -45deg; }
  [aria-expanded='true'],
  .mobile-menu__close { --x: 1; }

  /* ---- Sheet ---- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 var(--gutter) calc(var(--s-6) + env(safe-area-inset-bottom));
    border: 0;
    background: rgb(18 18 18 / .9);
    -webkit-backdrop-filter: saturate(180%) blur(24px);
    backdrop-filter: saturate(180%) blur(24px);
    color: var(--ink);
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
  }
  .mobile-menu[open] { display: flex; opacity: 1; }
  .mobile-menu::backdrop { background: none; }

  /* Mirrors the header bar, so the lines fold into the × in the same spot. */
  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: none;
    height: var(--header-h);
    padding-top: calc(var(--header-h) - var(--header-h-compact));
  }
  :global(.is-scrolled) .mobile-menu__top { height: var(--header-h-compact); padding-top: 0; }

  .mobile-menu__list { margin-top: var(--s-6); }
  .mobile-menu__list li + li { border-top: 1px solid var(--line); }
  .mobile-menu__list a {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 64px;
    color: var(--ink);
    font-size: var(--step-3);
    font-weight: 640;
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .mobile-menu__list a:hover { color: var(--accent-hover); }
  /* Section in view: the same clay dot as the desktop nav. */
  .mobile-menu__list .is-active::after { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }

  .mobile-menu__foot { display: grid; gap: var(--s-4); justify-items: start; margin-top: auto; padding-top: var(--s-7); }
  .mobile-menu__foot :global(.mobile-menu__cta) { width: 100%; }
  :global(html.has-open-menu) { overflow: hidden; }

  @media (prefers-reduced-motion: no-preference) {
    /* Fade the sheet in and out (the exit needs allow-discrete; without it the sheet simply closes). */
    .mobile-menu { transition: opacity var(--dur-2), display var(--dur-2) allow-discrete, overlay var(--dur-2) allow-discrete; }
    @starting-style {
      .mobile-menu[open] { opacity: 0; }
    }
    [open] li,
    [open] .mobile-menu__foot { animation: menu-in 700ms var(--ease-out) calc(var(--i) * 45ms + 60ms) both; }
    [open] .mobile-menu__close .mobile-menu__icon::before,
    [open] .mobile-menu__close .mobile-menu__icon::after { animation: menu-x 520ms var(--ease-out) 80ms both; }
    @keyframes menu-in {
      from { opacity: 0; transform: translateY(20px); }
    }
    @keyframes menu-x {
      from { transform: translateY(var(--y)) rotate(0deg); }
    }
  }
</style>
