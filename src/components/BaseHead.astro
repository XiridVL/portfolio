---
/**
 * Everything in <head>: charset/viewport, title + description, canonical,
 * hreflang alternates (en, it, x-default → en), Open Graph / Twitter,
 * theme-color, icons, font preloads + @font-face and JSON-LD. The site is
 * dark only, so there is no theme script.
 */
import { fontFaceCss, fontPreloads } from '../styles/fonts';
import { absoluteUrl, stripBase, withBase } from '../lib/url';
import { alternatesFor, localeMeta, routes, type Locale, type RouteKey } from '../i18n';
import { site } from '../data/site';
import { OG_HEIGHT, OG_WIDTH, ogImagePath, serializeJsonLd } from '../lib/seo';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Current route in the slug map; enables canonical + hreflang pairs. */
  routeKey?: RouteKey;
  /** Root-relative canonical path when there is no routeKey. Defaults to the current path. */
  canonicalPath?: string;
  /** Root-relative OG image path. Defaults to /og/{locale}-{routeKey}.png. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** One or more JSON-LD objects. */
  jsonLd?: unknown;
}

const { locale, title, description, routeKey, canonicalPath, ogImage, ogType = 'website', noindex = false, jsonLd } =
  Astro.props;

const path = routeKey ? routes[routeKey][locale] : (canonicalPath ?? stripBase(Astro.url.pathname));
const canonical = absoluteUrl(path);
const pair = routeKey ? alternatesFor(routeKey) : undefined;
const alternates = pair
  ? [
      { hreflang: localeMeta.en.hreflang, href: absoluteUrl(pair.en) },
      { hreflang: localeMeta.it.hreflang, href: absoluteUrl(pair.it) },
      { hreflang: 'x-default', href: absoluteUrl(pair.en) },
    ]
  : [];
const otherLocale: Locale = locale === 'en' ? 'it' : 'en';
const image = absoluteUrl(ogImage ?? ogImagePath(locale, routeKey ?? 'home'));
const ldBlocks = jsonLd === undefined ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd];

// scroll-fallback init: browsers without CSS scroll timelines (Firefox, older
// Safari) get .sd-js before first paint, so the entrance start states apply at
// once; BaseLayout's script then plays each entrance as it comes into view.
// If that script has not run within 2.5s, the class is removed and everything
// simply shows. Reduced motion never gets the class.
const scrollFallbackInit = `try{var d=document.documentElement;if(!CSS.supports('animation-timeline:view()')&&'IntersectionObserver'in window&&!matchMedia('(prefers-reduced-motion: reduce)').matches){d.classList.add('sd-js');setTimeout(function(){if(!window.__sdFallback)d.classList.remove('sd-js')},2500)}}catch(e){}`;

---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
{alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}

<meta name="theme-color" content="#121212" />
<meta name="color-scheme" content="dark" />
<script is:inline set:html={scrollFallbackInit} />

<link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
<link rel="icon" href={withBase('/favicon-32.png')} type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />

{fontPreloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
<style is:inline set:html={fontFaceCss}></style>

<meta property="og:site_name" content={site.name} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={String(OG_WIDTH)} />
<meta property="og:image:height" content={String(OG_HEIGHT)} />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={localeMeta[locale].og} />
{routeKey && <meta property="og:locale:alternate" content={localeMeta[otherLocale].og} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={title} />

{ldBlocks.map((block) => <script type="application/ld+json" set:html={serializeJsonLd(block)} />)}

<slot />
