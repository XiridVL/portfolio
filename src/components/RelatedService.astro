---
/**
 * "Related service" card on case studies: the lead question as a short
 * statement, then a small "See" label and the linked service names with
 * nudging arrows ("See C. Payments and integrations → or B. Web app or SaaS MVP →").
 * Links go to the home #services section of the current locale.
 */
import { getService, type ServiceId } from '../data/services';
import { sectionHref, useStrings, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Lead question, rendered as written. */
  lead: string;
  /** One or two service ids, in the order the copy names them. */
  services: ServiceId[];
  class?: string;
}
const { locale, lead, services, class: className } = Astro.props;
const t = useStrings(locale).caseStudy;
const href = sectionHref('services', locale, false);
const items = services.map((id) => ({ id, label: getService(id).content[locale].relatedLabel }));
---

<aside class:list={['related-service card glow-card sd-rise', className]} data-glow>
  <p class="related-service__lead">{lead}</p>
  <p class="related-service__links">
    <span class="related-service__see label">{t.relatedSee}</span>{' '}
    {
      items.map((item, i) => (
        <span class="related-service__item">
          {i > 0 && <>{t.relatedOr} </>}
          <a href={href} data-service={item.id}>
            <span class="related-service__name">{item.label}</span>&nbsp;<span class="related-service__arrow" aria-hidden="true">→</span>
          </a>
        </span>
      ))
    }
  </p>
</aside>

<style>
  .related-service { padding: clamp(var(--s-5), 4vw, var(--s-7)); }
  .related-service__lead {
    max-width: 32ch;
    color: var(--ink);
    font-size: var(--step-2);
    font-weight: 620;
    line-height: 1.25;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }
  .related-service__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-4);
    margin-top: var(--s-5);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
  .related-service__see { color: var(--muted); }
  /* "or" travels with the link it introduces, so a wrap never strands it. */
  .related-service__item { display: inline-flex; align-items: center; gap: 0.4em; }
  .related-service__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    text-decoration: none;
  }
  .related-service__links a:hover .related-service__name { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.25em; }
  .related-service__arrow { display: inline-block; transition: transform var(--dur-2) var(--ease-out); }
  .related-service__links a:hover .related-service__arrow,
  .related-service__links a:focus-visible .related-service__arrow { transform: translateX(4px); }
</style>
