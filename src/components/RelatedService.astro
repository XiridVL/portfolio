---
/**
 * "Related service" card on case studies:
 *   *Need subscriptions, sign-in or SEO done properly?* See C. Payments and integrations → or B. Web app or SaaS MVP →
 * Links go to the home #services section of the current locale.
 */
import { getService, type ServiceId } from '../data/services';
import { sectionHref, useStrings, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Italic lead question, without trailing punctuation changes. */
  lead: string;
  /** One or two service ids, in the order the copy names them. */
  services: ServiceId[];
  class?: string;
}
const { locale, lead, services, class: className } = Astro.props;
const t = useStrings(locale).caseStudy;
const href = sectionHref('services', locale, false);
const items = services.map((id) => ({ id, label: getService(id).content[locale].relatedLabel }));
---

<aside class:list={['related-service card', className]}>
  <p class="related-service__lead"><em>{lead}</em></p>
  <p class="related-service__links">
    {t.relatedSee}{' '}
    {
      items.map((item, i) => (
        <>
          {i > 0 && <> {t.relatedOr} </>}
          <a href={href} data-service={item.id}><strong>{item.label}</strong>&nbsp;<span aria-hidden="true">→</span></a>
        </>
      ))
    }
  </p>
</aside>

<style>
  .related-service {
    padding: var(--s-5);
    border-top: 1.5px solid var(--horizon);
    border-radius: 0 0 var(--r-card) var(--r-card);
  }
  .related-service__lead { font-size: var(--step-1); }
  .related-service__links { margin-top: var(--s-2); }
  .related-service__links a { display: inline-block; padding-block: 10px; }
</style>
