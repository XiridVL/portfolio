---
/**
 * Locale-aware price: "from €1,200 + VAT where due" / "da €1.200 + IVA se dovuta".
 * Big tabular amount; "from" and the per-unit wording sit small and muted on its
 * baseline, the VAT suffix on its own line below. The suffix follows
 * `site.vatApplies`. Prices never animate.
 */
import { site } from '../data/site';
import { formatPrice } from '../lib/format';
import { useStrings, type Locale } from '../i18n';

interface Props {
  amount: number;
  locale: Locale;
  /** Recurring price: renders "/month" / "/mese". */
  per?: 'month';
  /** Prefix with "from" / "da" (default true). */
  from?: boolean;
  size?: 'md' | 'lg';
  class?: string;
}
const { amount, locale, per, from = true, size = 'lg', class: className } = Astro.props;
const t = useStrings(locale).price;
---

<p class:list={['price-tag', `price-tag--${size}`, className]}>
  <span class="price-tag__value">
    {from && <span class="price-tag__from">{t.from} </span>}<span class="price-tag__amount text-gradient">{formatPrice(amount, locale)}</span>{per === 'month' && <span class="price-tag__per">{t.perMonth}</span>}
  </span>
  {site.vatApplies && <span class="price-tag__vat">{t.vatSuffix}</span>}
</p>

<style>
  .price-tag {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    container-type: inline-size;
  }
  .price-tag__value { white-space: nowrap; }
  .price-tag__from, .price-tag__per, .price-tag__vat { font-size: var(--step--1); font-weight: 500; color: var(--muted); }
  .price-tag__per { margin-inline-start: 0.2em; }
  .price-tag__amount { font-weight: 680; line-height: 1; letter-spacing: -0.045em; }
  /* Scales with the card so the amount never crowds a narrow column. */
  .price-tag--lg .price-tag__amount { font-size: min(var(--step-5), 16cqi); }
  .price-tag--md .price-tag__amount { font-size: var(--step-2); letter-spacing: -0.03em; }
  .price-tag__vat { flex-basis: 100%; }
</style>
