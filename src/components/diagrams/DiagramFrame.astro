---
/**
 * Shared shell for the case-study diagrams (spec §11).
 *
 * Renders two inline SVGs from the same steps: a wide layout and a tall one
 * for narrow screens (toggled by a media query, so only one is ever in the
 * accessibility tree), followed by the ordered-list text equivalent.
 *
 * Step groups inside the SVGs and the list items carry data-step="n";
 * CaseStudyLayout's diagram-link script adds .is-active to every element with
 * the same step, so the highlights, the list and the drawing light up together.
 * The list items are focusable, which gives keyboard users the same link.
 */
interface Props {
  /** Unique prefix for the <title>/<desc> ids. */
  id: string;
  title: string;
  desc: string;
  /** The ordered-list text equivalent, one entry per diagram step. */
  steps: string[];
  wideViewBox: string;
  tallViewBox: string;
  class?: string;
}
const { id, title, desc, steps, wideViewBox, tallViewBox, class: className } = Astro.props;
---

<div class:list={['diagram', className]}>
  <div class="diagram__canvas">
    <svg
      class="diagram__svg diagram__svg--wide"
      viewBox={wideViewBox}
      role="img"
      aria-labelledby={`${id}-wide-title ${id}-wide-desc`}
      focusable="false"
    >
      <title id={`${id}-wide-title`}>{title}</title>
      <desc id={`${id}-wide-desc`}>{desc}</desc>
      <slot name="wide" />
    </svg>
    <svg
      class="diagram__svg diagram__svg--tall"
      viewBox={tallViewBox}
      role="img"
      aria-labelledby={`${id}-tall-title ${id}-tall-desc`}
      focusable="false"
    >
      <title id={`${id}-tall-title`}>{title}</title>
      <desc id={`${id}-tall-desc`}>{desc}</desc>
      <slot name="tall" />
    </svg>
  </div>
  <ol class="diagram__steps" role="list">
    {
      steps.map((step, i) => (
        <li class="diagram__step" data-step={i + 1} tabindex="0">
          <span class="diagram__num mono" aria-hidden="true">{i + 1}</span>
          <span>{step}</span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .diagram {
    --diagram-bg: var(--surface);
  }
  .diagram__canvas {
    padding: var(--s-5) var(--s-4);
    background: var(--diagram-bg);
    border: 1px solid var(--line);
    border-top: 1.5px solid var(--horizon);
    border-radius: 0 0 var(--r-card) var(--r-card);
    color: var(--ink);
  }
  .diagram__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font-mono);
  }
  /* Font sizes are in user units; both layouts keep labels at 12px or more on screen. */
  .diagram__svg--wide { font-size: 16px; }
  .diagram__svg--tall { font-size: 13px; max-width: 460px; margin-inline: auto; display: none; }
  @media (max-width: 899px) {
    .diagram__svg--wide { display: none; }
    .diagram__svg--tall { display: block; }
    .diagram__canvas { padding-inline: var(--s-3); }
  }

  /* drawing primitives */
  .diagram :global(.d-box) { fill: var(--diagram-bg); stroke: currentColor; stroke-width: 1.5; }
  .diagram :global(.d-box--quiet) { stroke: var(--line-strong); stroke-width: 1; }
  .diagram :global(.d-box--dashed) { stroke-dasharray: 6 5; }
  .diagram :global(.d-fill) { fill: var(--sea); stroke: none; }
  .diagram :global(.d-rule) { stroke: var(--line-strong); stroke-width: 1; fill: none; }
  .diagram :global(.d-rule--dashed) { stroke-dasharray: 3 5; }
  .diagram :global(.d-line) { fill: none; stroke: currentColor; stroke-width: 1.5; }
  .diagram :global(.d-line--dashed) { stroke-dasharray: 6 5; }
  .diagram :global(.d-head) { fill: currentColor; stroke: none; }
  .diagram :global(.d-label) { fill: var(--ink); stroke: none; font-weight: 400; }
  .diagram :global(.d-label--halo) {
    paint-order: stroke;
    stroke: var(--diagram-bg);
    stroke-width: 5px;
    stroke-linejoin: round;
  }
  .diagram :global(.d-muted) { fill: var(--muted); }
  .diagram :global(.d-strike) { stroke: var(--muted); stroke-width: 1.5; }
  .diagram :global(.d-badge circle) { fill: var(--diagram-bg); stroke: var(--sea); stroke-width: 1.5; }
  .diagram :global(.d-badge text) { fill: var(--sea); stroke: none; font-weight: 400; font-size: 0.875em; }
  .diagram :global(.d-step) { cursor: default; }

  /* active step (diagram-link) */
  .diagram :global([data-step] .d-line),
  .diagram :global([data-step] .d-box),
  .diagram :global([data-step] .d-head),
  .diagram :global([data-step] .d-badge circle) {
    transition: stroke var(--dur-1) ease, fill var(--dur-1) ease;
  }
  .diagram :global([data-step].is-active .d-line),
  .diagram :global([data-step].is-active .d-box) { stroke: var(--buoy); stroke-width: 2; }
  .diagram :global([data-step].is-active .d-head) { fill: var(--buoy); }
  .diagram :global([data-step].is-active .d-label) { font-weight: 600; }
  .diagram :global([data-step].is-active .d-badge circle) { stroke: var(--buoy); stroke-width: 2; }
  .diagram :global([data-step].is-active .d-badge text) { fill: var(--buoy-ink); font-weight: 600; }

  /* text equivalent */
  .diagram__steps {
    list-style: none;
    padding: 0;
    margin: var(--s-5) auto 0;
    max-width: var(--reading);
    display: grid;
    gap: var(--s-1);
  }
  .diagram__step {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: var(--s-3);
    align-items: baseline;
    padding: var(--s-2) var(--s-3);
    border-radius: 2px;
  }
  .diagram__num {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 1.5px solid var(--sea);
    border-radius: 50%;
    color: var(--sea);
    font-size: var(--step--2);
    font-weight: 400;
    line-height: 1;
  }
  .diagram__step.is-active { background: var(--surface-2); }
  .diagram__step.is-active .diagram__num { border-color: var(--buoy); color: var(--buoy-ink); font-weight: 600; }
  @media (prefers-reduced-motion: reduce) {
    .diagram :global([data-step] *) { transition: none; }
  }
</style>
