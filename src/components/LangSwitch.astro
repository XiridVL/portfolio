---
/**
 * EN / IT switch using the slug map (src/i18n/routes.ts). Plain links, never
 * an automatic redirect. The choice is stored in localStorage `ac-lang` only
 * to remember the active state.
 */
import { localeHref, localeMeta, locales, useStrings, type Locale, type RouteKey } from '../i18n';

interface Props {
  locale: Locale;
  /** Current route; falls back to the home page of each locale (e.g. on 404). */
  routeKey?: RouteKey;
  class?: string;
}
const { locale, routeKey = 'home', class: className } = Astro.props;
const t = useStrings(locale);
---

<div class:list={['lang-switch', className]} role="group" aria-label={t.lang.groupLabel}>
  {
    locales.map((l, i) => (
      <>
        {i > 0 && <span class="lang-switch__sep" aria-hidden="true">/</span>}
        <a
          class="lang-switch__link"
          href={localeHref(routeKey, l)}
          hreflang={localeMeta[l].hreflang}
          lang={localeMeta[l].htmlLang}
          aria-current={l === locale ? 'true' : undefined}
          data-lang={l}
        >
          {localeMeta[l].short}
          <span class="visually-hidden">{` ${localeMeta[l].name}`}</span>
        </a>
      </>
    ))
  }
</div>

<script>
  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[data-lang]');
    if (!link?.dataset.lang) return;
    try {
      localStorage.setItem('ac-lang', link.dataset.lang);
    } catch {
      /* storage unavailable: nothing to remember */
    }
  });
</script>

<style>
  .lang-switch { display: inline-flex; align-items: center; font-family: var(--font-mono); font-size: var(--step--1); }
  .lang-switch__sep { color: var(--muted); }
  .lang-switch__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--muted);
    text-decoration: none;
    font-weight: 400;
    letter-spacing: 0.04em;
  }
  .lang-switch__link:hover { color: var(--ink); text-decoration: underline; }
  .lang-switch__link[aria-current='true'] { color: var(--ink); text-decoration: underline; text-decoration-color: var(--buoy); text-decoration-thickness: 2px; text-underline-offset: 0.35em; }
</style>
