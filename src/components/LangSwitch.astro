---
/**
 * EN / IT segmented pill using the slug map (src/i18n/routes.ts). The current
 * locale is the filled segment. Plain links, never an automatic redirect. The
 * choice is stored in localStorage `ac-lang` only to remember the active state.
 */
import { localeHref, localeMeta, locales, useStrings, type Locale, type RouteKey } from '../i18n';

interface Props {
  locale: Locale;
  /** Current route; falls back to the home page of each locale (e.g. on 404). */
  routeKey?: RouteKey;
  class?: string;
}
const { locale, routeKey = 'home', class: className } = Astro.props;
const t = useStrings(locale);
---

<div class:list={['lang-switch', className]} role="group" aria-label={t.lang.groupLabel}>
  {
    locales.map((l) => (
      <a
        class="lang-switch__link"
        href={localeHref(routeKey, l)}
        hreflang={localeMeta[l].hreflang}
        lang={localeMeta[l].htmlLang}
        aria-current={l === locale ? 'true' : undefined}
        data-lang={l}
      >
        {localeMeta[l].short}
        <span class="visually-hidden">{` ${localeMeta[l].name}`}</span>
      </a>
    ))
  }
</div>

<script>
  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[data-lang]');
    if (!link?.dataset.lang) return;
    try {
      localStorage.setItem('ac-lang', link.dataset.lang);
    } catch {
      /* storage unavailable: nothing to remember */
    }
  });
</script>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: rgb(242 239 232 / .03);
  }
  .lang-switch__link {
    position: relative;
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    height: 28px;
    border-radius: var(--r-pill);
    color: var(--muted);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: color var(--dur-1) ease, background-color var(--dur-1) ease;
  }
  /* 44px tall hit area around the 28px segment. */
  .lang-switch__link::after { content: ""; position: absolute; inset: -8px 0; }
  .lang-switch__link:hover { color: var(--ink); }
  .lang-switch__link[aria-current='true'] {
    background: var(--surface-3);
    color: var(--ink);
    box-shadow: 0 1px 0 rgb(255 255 255 / .06) inset, 0 1px 2px rgb(0 0 0 / .4);
  }
</style>
