---
import { MONOGRAM } from '../lib/monogram';
/**
 * AC monogram (spec §8.4). The A has no crossbar; the amber horizon line is the
 * crossbar, running through the A's legs and the opening of the C.
 *
 * variant="mark"    solid strokes (header, footer, favicon)
 * variant="lockup"  mark + "Andrea Capelli" wordmark
 * variant="outline" 1px outline strokes (About illustration, ~240px)
 *
 * Decorative by default (aria-hidden). Pass `label` to expose it as an image.
 */
interface Props {
  size?: number;
  variant?: 'mark' | 'lockup' | 'outline';
  label?: string;
  /** Colour behind the outline variant (used to hollow the strokes). */
  knockout?: string;
  /** Draw the crossbar on load (hero motion, spec §12.1). */
  drawCrossbar?: boolean;
  class?: string;
}

const {
  size = 28,
  variant = 'mark',
  label,
  knockout = 'var(--bg)',
  drawCrossbar = false,
  class: className,
} = Astro.props;

const { a: A, c: C, bar: BAR } = MONOGRAM;
const unit = 64 / size; // viewBox units per CSS pixel
const barWidth = variant === 'outline' ? Math.max(1.5 * unit, 1) : size <= 32 ? 6 : 5;
const a11y = label
  ? { role: 'img' as const, 'aria-label': label }
  : { 'aria-hidden': 'true' as const, focusable: 'false' as const };
---

{
  variant === 'lockup' ? (
    <span class:list={['monogram-lockup', className]}>
      <svg class="monogram" width={size} height={size} viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false">
        <g stroke="currentColor" stroke-width="9" stroke-linecap="round" stroke-linejoin="round">
          <path d={A} />
          <path d={C} />
        </g>
        <path class:list={['monogram__bar', { 'is-drawing': drawCrossbar }]} d={BAR} stroke="var(--buoy)" stroke-width={barWidth} stroke-linecap="round" pathLength="1" />
      </svg>
      <span class="monogram-lockup__word">Andrea Capelli</span>
    </span>
  ) : (
    <svg class:list={['monogram', `monogram--${variant}`, className]} width={size} height={size} viewBox="0 0 64 64" fill="none" {...a11y}>
      {variant === 'outline' ? (
        <>
          <g stroke="currentColor" stroke-width="9" stroke-linecap="round" stroke-linejoin="round">
            <path d={A} />
            <path d={C} />
          </g>
          <g stroke={knockout} stroke-width={9 - 2 * unit} stroke-linecap="round" stroke-linejoin="round">
            <path d={A} />
            <path d={C} />
          </g>
        </>
      ) : (
        <g stroke="currentColor" stroke-width="9" stroke-linecap="round" stroke-linejoin="round">
          <path d={A} />
          <path d={C} />
        </g>
      )}
      <path class:list={['monogram__bar', { 'is-drawing': drawCrossbar }]} d={BAR} stroke="var(--buoy)" stroke-width={barWidth} stroke-linecap="round" pathLength="1" />
    </svg>
  )
}

<style>
  .monogram { color: var(--ink); overflow: visible; }
  .monogram__bar { stroke-dasharray: 1; stroke-dashoffset: 0; }
  .monogram__bar.is-drawing { animation: crossbar-draw var(--dur-3) var(--ease-tide) both; }
  @keyframes crossbar-draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  .monogram-lockup {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--ink);
  }
  .monogram-lockup__word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
  }
</style>
