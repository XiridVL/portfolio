---
/**
 * Plain text chip for tech stacks ("Astro", "Stripe"): a quiet raised pill.
 * Not interactive. For a list, use <ChipList items={[...]} />.
 */
interface Props {
  text: string;
  class?: string;
}
const { text, class: className } = Astro.props;
---

<span class:list={['chip', className]}>{text}</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 6px 15px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--surface-2);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 520;
    line-height: 1.3;
    letter-spacing: -0.005em;
    white-space: nowrap;
  }
</style>
