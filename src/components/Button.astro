---
/**
 * Button or link styled as a button. Pill shaped.
 *   variant="primary"    clay-amber fill, dark label (main call to action)
 *   variant="secondary"  translucent ivory glass with a hairline border
 *   variant="text"       clay text link with optional arrow
 * `arrow` appends an aria-hidden → or ↓ that nudges on hover. Pass the
 * label WITHOUT the arrow character: <Button href="#contact" arrow="right">Get a free quote</Button>
 * Renders <a> when `href` is set, otherwise <button>.
 */
import type { HTMLAttributes } from 'astro/types';

type Common = {
  variant?: 'primary' | 'secondary' | 'text';
  arrow?: 'right' | 'down';
  size?: 'md' | 'lg';
  class?: string;
};
type Props = Common & (HTMLAttributes<'a'> | HTMLAttributes<'button'>);

const { variant = 'primary', arrow, size = 'md', class: className, href, ...rest } = Astro.props as Common &
  HTMLAttributes<'a'> & HTMLAttributes<'button'>;
const Tag = href ? 'a' : 'button';
const classes = ['btn', `btn--${variant}`, `btn--${size}`, className];
const glyph = arrow === 'right' ? '→' : arrow === 'down' ? '↓' : null;
const buttonType = !href && !rest.type ? 'button' : rest.type;
---

<Tag href={href} class:list={classes} {...rest} type={buttonType}>
  <span class="btn__label"><slot /></span>{glyph && <span class:list={['btn__arrow', `btn__arrow--${arrow}`]} aria-hidden="true">{glyph}</span>}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    min-height: 44px;
    padding: 0 22px;
    border: 1px solid transparent;
    border-radius: var(--r-pill);
    font-family: var(--font-sans);
    font-weight: 580;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--dur-1) ease,
      color var(--dur-1) ease,
      border-color var(--dur-1) ease,
      box-shadow var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }
  .btn:active { transform: scale(0.97); }
  .btn--lg { min-height: 52px; padding: 0 28px; font-size: 1.0625rem; }

  .btn--primary { background: var(--accent); color: var(--on-accent); }
  .btn--primary:hover {
    background: var(--accent-hover);
    color: var(--on-accent);
    box-shadow: 0 0 0 6px rgb(217 160 102 / .12), 0 14px 36px -12px rgb(217 160 102 / .55);
  }

  .btn--secondary {
    background: rgb(242 239 232 / .06);
    color: var(--ink);
    border-color: var(--line-2);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .btn--secondary:hover { background: rgb(242 239 232 / .11); color: var(--ink); border-color: rgb(242 239 232 / .28); }

  .btn--text {
    min-height: 44px;
    padding-inline: 0;
    background: none;
    color: var(--accent);
  }
  .btn--text:hover { color: var(--accent-hover); }
  .btn--text:hover .btn__label { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.25em; }

  .btn__arrow { display: inline-block; transition: transform var(--dur-2) var(--ease-out); }
  .btn:hover .btn__arrow--right, .btn:focus-visible .btn__arrow--right { transform: translateX(4px); }
  .btn:hover .btn__arrow--down, .btn:focus-visible .btn__arrow--down { transform: translateY(3px); }
</style>
