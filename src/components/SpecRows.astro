---
/**
 * Spec rows: a compact definition list. Small muted label on the left, value
 * on the right, hairline dividers between rows; on a narrow container the
 * label sits above its value. A row may carry `links` instead of (or after)
 * `value`; external links get ↗ and the "opens in a new tab" hint.
 *
 * size="sm" for cards, "md" (default) for the case-study spec sheet.
 */
import ExternalLink from './ExternalLink.astro';
import type { Locale } from '../i18n/locales';

export interface SpecRowItem {
  label: string;
  value?: string;
  links?: { label: string; href: string; external?: boolean }[];
}

interface Props {
  rows: SpecRowItem[];
  locale?: Locale;
  size?: 'sm' | 'md';
  label?: string;
  class?: string;
}
const { rows, locale = 'en', size = 'md', label, class: className } = Astro.props;
---

<dl class:list={['spec-rows', `spec-rows--${size}`, className]} aria-label={label}>
  {
    rows.map((row) => (
      <div class="spec-rows__row">
        <dt class="spec-rows__label">{row.label}</dt>
        <dd class="spec-rows__value">
          {row.value}
          {row.links && row.links.length > 0 && (
            <span class="spec-rows__links">
              {row.links.map((link, i) => (
                <>
                  {i > 0 && <span aria-hidden="true"> · </span>}
                  {link.external === false || link.href.startsWith('/') ? (
                    <a href={link.href}>{link.label}</a>
                  ) : (
                    <ExternalLink href={link.href} locale={locale}>{link.label}</ExternalLink>
                  )}
                </>
              ))}
            </span>
          )}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  /* Container query: the row layout follows the list's own width (cards and case headers). */
  .spec-rows { --spec-label: 7rem; margin: 0; container-type: inline-size; }
  .spec-rows--md { --spec-label: 9rem; }
  .spec-rows__row {
    display: grid;
    grid-template-columns: var(--spec-label) minmax(0, 1fr);
    align-items: baseline;
    gap: 2px var(--s-4);
    padding-block: 10px;
  }
  .spec-rows__row + .spec-rows__row { border-top: 1px solid var(--line); }
  .spec-rows__label {
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--muted);
  }
  .spec-rows__value { margin: 0; color: var(--text); line-height: 1.5; }
  .spec-rows__links a { white-space: nowrap; }
  .spec-rows--sm .spec-rows__value { font-size: var(--step--1); }
  .spec-rows--md .spec-rows__row { padding-block: 14px; }
  .spec-rows--md .spec-rows__label { font-size: var(--step--1); }
  .spec-rows--md .spec-rows__value { font-size: 0.9375rem; }
  /* Narrow: label above value. */
  @container (max-width: 319px) {
    .spec-rows__row { grid-template-columns: minmax(0, 1fr); }
  }
  @container (max-width: 439px) {
    .spec-rows--md .spec-rows__row { grid-template-columns: minmax(0, 1fr); }
  }
</style>
