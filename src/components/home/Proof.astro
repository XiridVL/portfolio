---
/**
 * Proof strip (#proof): visually hidden H2, five big figures in one row split
 * by hairlines, the footnote, then the tech line as a slow sideways marquee.
 */
import Soundings from '../Soundings.astro';
import ChipList from '../ChipList.astro';
import { homeCopy } from '../../i18n/home';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = homeCopy[locale].proof;
---

<section id="proof" class="proof section" aria-labelledby="proof-title">
  <div class="container">
    <h2 id="proof-title" class="visually-hidden">{copy.title}</h2>
    <Soundings items={copy.items} footnote={copy.footnote} variant="strip" />
    <ChipList items={copy.tech} marquee class="proof__tech sd-rise" />
  </div>
</section>

<style>
  .proof { padding-block: clamp(72px, 9vw, 136px) clamp(48px, 7vw, 104px); }
  .proof :global(.proof__tech) { margin-top: clamp(var(--s-7), 6vw, var(--s-9)); }
</style>
