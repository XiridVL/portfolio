---
/**
 * "Doesn't fit a box?" feature panel under the service cards: gradient hairline
 * ring, a slow ember glow inside, the copy on the left and the call to action on
 * the right (stacked on phones). The button preselects "custom" in the brief builder.
 */
import AccentText from '../AccentText.astro';
import Button from '../Button.astro';
import { site } from '../../data/site';
import { serviceHref, type Locale } from '../../i18n';
import { homeCopy } from '../../i18n/home';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = homeCopy[locale].services.custom;
---

<aside class="quote-panel ring-accent sd-scale" aria-labelledby="custom-quote-title">
  <span class="quote-panel__ember ember ember--drift" aria-hidden="true"></span>
  <div class="quote-panel__copy">
    <h3 id="custom-quote-title" class="quote-panel__title"><AccentText text={copy.title} accent={copy.accent} /></h3>
    <p class="quote-panel__text">{copy.text}</p>
  </div>
  <div class="quote-panel__actions">
    <Button href={serviceHref('custom', locale)} size="lg" arrow="right" data-service-link="custom">{copy.button}</Button>
    <p class="quote-panel__email">
      {copy.orEmail} <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
  </div>
</aside>

<style>
  .quote-panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    gap: var(--s-6);
    margin-top: 20px;
    padding: clamp(28px, 5vw, 64px);
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-lg);
  }
  .quote-panel__ember { width: min(780px, 140%); inset: auto -24% -78% auto; }
  .quote-panel__title { max-width: 18ch; font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem); line-height: 1.08; letter-spacing: -0.03em; }
  .quote-panel__text { max-width: 54ch; margin-top: var(--s-4); color: var(--muted); }
  .quote-panel__actions { display: grid; gap: var(--s-2); justify-items: start; }
  .quote-panel__actions :global(.btn) { white-space: normal; text-align: center; }
  .quote-panel__email { font-size: var(--step--1); color: var(--muted); overflow-wrap: anywhere; }
  .quote-panel__email a { display: inline-block; padding-block: 11px; }
  @media (max-width: 599px) {
    .quote-panel__actions { justify-items: stretch; }
  }
  @media (min-width: 900px) {
    .quote-panel { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); align-items: center; gap: var(--s-8); }
    .quote-panel__actions { justify-items: center; text-align: center; }
  }
</style>
