---
/**
 * Services and prices (#services): six package cards in a bento grid (3 columns
 * from 1100px, 2 from 700px), the custom quote feature panel and the rates band.
 * Cards rise in as they scroll into view, staggered by column; their inner rows
 * line up across each grid row through subgrid.
 */
import SectionHeader from '../SectionHeader.astro';
import ServiceCard from '../ServiceCard.astro';
import CustomQuotePanel from './CustomQuotePanel.astro';
import RatesBand from './RatesBand.astro';
import { services } from '../../data/services';
import { homeCopy } from '../../i18n/home';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = homeCopy[locale].services;
---

<section id="services" class="section" aria-labelledby="services-title">
  <div class="container">
    <SectionHeader id="services" number={copy.number} label={copy.label} title={copy.title} accent={copy.accent} intro={copy.intro} />
    <ul class="services-grid" role="list">
      {
        services.map((service, i) => (
          <li class="services-grid__item sd-rise" style={`--c2: ${i % 2}; --c3: ${i % 3}`}>
            <ServiceCard service={service} locale={locale} />
          </li>
        ))
      }
    </ul>
    <CustomQuotePanel locale={locale} />
    <RatesBand locale={locale} />
  </div>
</section>

<style>
  .services-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: minmax(0, 1fr);
  }
  /* Each item spans the card's six rows, so heads, prices and actions line up across a row. */
  .services-grid__item { --i: 0; display: grid; grid-row: span 6; grid-template-rows: subgrid; row-gap: 0; }
  @media (min-width: 700px) {
    .services-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .services-grid__item { --i: var(--c2); }
  }
  @media (min-width: 1100px) {
    .services-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .services-grid__item { --i: var(--c3); }
  }
</style>
