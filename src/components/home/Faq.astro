---
/**
 * FAQ (#faq, spec §3.7 / §4.7): native <details>, all closed. The FAQPage
 * JSON-LD is built by the page from the same items (homeCopy[locale].faq.items).
 */
import SectionHeader from '../SectionHeader.astro';
import { homeCopy } from '../../i18n/home';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = homeCopy[locale].faq;
---

<section id="faq" class="section section--deferred" aria-labelledby="faq-title">
  <div class="container">
    <SectionHeader id="faq" number={copy.number} label={copy.label} title={copy.title} />
    <div class="faq">
      {
        copy.items.map((item) => (
          <details class="faq__item">
            <summary class="faq__question">
              <span>{item.question}</span>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <p class="faq__answer">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq { max-width: 860px; border-top: 1.5px solid var(--horizon); }
  .faq__item { border-bottom: 1px solid var(--line-strong); }
  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 44px;
    padding-block: var(--s-4);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 650;
    line-height: 1.25;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }
  .faq__question::-webkit-details-marker { display: none; }
  .faq__question:hover { color: var(--sea); }
  .faq__icon {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    border-top: 1.5px solid currentColor;
    transform: translateY(-50%);
    transition: transform var(--dur-2) var(--ease-tide);
  }
  .faq__icon::after { transform: translateY(-50%) rotate(90deg); }
  .faq__item[open] .faq__icon::after { transform: translateY(-50%) rotate(0deg); }
  .faq__answer {
    max-width: var(--measure);
    padding-bottom: var(--s-5);
    color: var(--muted);
  }
</style>
