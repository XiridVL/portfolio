---
/**
 * Home hero (#top): a centred keynote opening. Glass eyebrow pill with a
 * pulsing dot, two-line H1 with one italic serif accent word, sub copy, three
 * calls to action and the microline; below it the stream panel stands on a lit
 * stage that peeks into the first screen on desktop.
 * Motion is CSS only: the head rises in on load and drifts away as the page
 * scrolls (sd-exit); the panel starts tilted back and stands up (sd-tilt).
 * Without support, or under reduced motion, everything renders in place.
 */
import AccentText from '../AccentText.astro';
import Button from '../Button.astro';
import StreamPanel from '../mockups/StreamPanel.astro';
import { homeCopy } from '../../i18n/home';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = homeCopy[locale].hero;
// The accent word sits on one title line; a copy edit that drops it fails the build.
const accentLine = copy.titleLines.findIndex((line) => line.includes(copy.titleAccent));
if (accentLine < 0) throw new Error(`Hero accent "${copy.titleAccent}" not found in the title`);
// Wrap only at the " · " separators, keeping each part (and the dot) together.
const keepParts = (text: string) =>
  text
    .split(/( · )/)
    .map((part, i) => (i % 2 ? `\u00A0${part.trim()} ` : part.replaceAll(' ', '\u00A0')))
    .join('');
---

<section id="top" class="hero" aria-labelledby="top-title">
  <div class="hero__bg" aria-hidden="true">
    <span class="ember ember--drift hero__ember--clay"></span>
    <span class="ember hero__ember--ivory"></span>
  </div>

  <div class="container">
    <div class="hero__head sd-exit">
      <p class="hero__eyebrow eyebrow ld-rise" style="--i: 0">
        <span class="hero__pulse" aria-hidden="true"></span>
        <span>{keepParts(copy.eyebrow)}</span>
      </p>
      <h1 id="top-title" class="hero__title">
        {
          copy.titleLines.map((line, i) => (
            <>
              {i > 0 && ' '}
              <span class="hero__line ld-rise" style={`--i: ${i + 1}`}>
                <AccentText text={line} accent={i === accentLine ? copy.titleAccent : undefined} />
              </span>
            </>
          ))
        }
      </h1>
      <p class="hero__sub lead ld-rise" style="--i: 3">{copy.sub}</p>
      <div class="hero__actions ld-rise" style="--i: 4">
        <Button href="#contact" arrow="right" size="lg">{copy.primary}</Button>
        <Button href="#services" variant="secondary" arrow="down" size="lg">{copy.secondary}</Button>
        <Button href="#work" variant="text" arrow="down">{copy.tertiary}</Button>
      </div>
      <p class="hero__micro ld-rise" style="--i: 5">{keepParts(copy.microline)}</p>
    </div>

    <figure class="hero__stage ld-fade" style="--i: 5">
      <div class="hero__device">
        <span class="ember hero__glow" aria-hidden="true"></span>
        <div class="hero__tilt sd-tilt">
          <StreamPanel locale={locale} />
        </div>
      </div>
      <figcaption class="hero__caption">{copy.caption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    --hero-peek: clamp(150px, 22svh, 240px);
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    padding-block: var(--s-7) var(--s-8);
    scroll-margin-top: 80px;
  }

  /* Atmosphere: a drifting clay ember, a fainter ivory one, and a 64px hairline
     grid that fades out from the headline. CSS backgrounds only. */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .hero__bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgb(242 239 232 / .04) 1px, transparent 1px) 0 0 / 64px 64px,
      linear-gradient(90deg, rgb(242 239 232 / .04) 1px, transparent 1px) calc(50% + 32px) 0 / 64px 64px;
    -webkit-mask-image: radial-gradient(ellipse 58% 34% at 50% 24%, #000 10%, transparent 100%);
    mask-image: radial-gradient(ellipse 58% 34% at 50% 24%, #000 10%, transparent 100%);
  }
  .hero__ember--clay { width: min(1080px, 120vw); top: max(-520px, -60vw); right: max(-400px, -50vw); }
  .hero__ember--ivory {
    width: min(820px, 110vw);
    top: 6%;
    left: max(-420px, -55vw);
    background: radial-gradient(closest-side, rgb(242 239 232 / .05), rgb(242 239 232 / .015) 55%, transparent);
  }

  /* Head: centred column. From tablet up it fills the first screen minus a peek of the panel. */
  .hero__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: var(--s-8);
    text-align: center;
  }
  @media (min-width: 768px) and (min-height: 600px) {
    .hero { padding-top: 0; }
    .hero__head {
      min-height: calc(100svh - var(--header-h) - var(--hero-peek));
      justify-content: center;
      padding-block: var(--s-6) var(--s-3);
    }
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 34px;
    padding: 7px 18px 7px 14px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-pill);
    background: rgb(242 239 232 / .04);
    box-shadow: 0 1px 0 rgb(255 255 255 / .05) inset;
    text-wrap: balance;
  }
  .hero__pulse {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px rgb(217 160 102 / .7);
    flex: none;
  }

  .hero__title {
    margin-top: var(--s-6);
    /* Sized so each English title line holds on one line from ~600px up. */
    font-size: clamp(2.75rem, min(8vw, 12svh), 6.25rem);
  }
  .hero__line { display: block; }

  .hero__sub { max-width: 58ch; margin-top: var(--s-6); }
  @media (max-width: 479px) {
    .hero__sub { font-size: 1.0625rem; }
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--s-3) var(--s-4);
    margin-top: var(--s-6);
  }
  .hero__micro {
    margin-top: var(--s-5);
    font-size: var(--step--1);
    color: var(--faint);
  }

  /* Stage: the panel on a lit floor, ember light spilling from behind it. */
  .hero__stage {
    position: relative;
    isolation: isolate;
    max-width: 920px;
    margin-inline: auto;
  }
  .hero__device { position: relative; }
  .hero__glow {
    width: 124%;
    aspect-ratio: 1.6;
    left: -12%;
    top: 26%;
    background: radial-gradient(closest-side, rgb(217 160 102 / .24), rgb(217 160 102 / .07) 55%, transparent);
  }
  .hero__device::before,
  .hero__device::after {
    content: "";
    position: absolute;
    top: 100%;
    pointer-events: none;
  }
  /* Floor highlight and its soft reflection. */
  .hero__device::before {
    left: 12%;
    right: 12%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(242 239 232 / .28), transparent);
  }
  .hero__device::after {
    left: 6%;
    right: 6%;
    height: 96px;
    background: radial-gradient(50% 100% at 50% 0%, rgb(242 239 232 / .08), transparent 80%);
  }
  .hero__tilt :global(.mk) {
    border-radius: 18px;
    box-shadow: 0 1px 0 rgb(255 255 255 / .06) inset, 0 28px 56px -28px rgb(0 0 0 / .85);
  }
  .hero__caption {
    max-width: 52ch;
    margin: var(--s-8) auto 0;
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--muted);
    text-align: center;
    text-wrap: balance;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__pulse::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: var(--accent);
      animation: hero-pulse 2.4s var(--ease-out) infinite;
    }
    @keyframes hero-pulse {
      from { opacity: .7; transform: scale(1); }
      to { opacity: 0; transform: scale(3.4); }
    }
    /* Phones: the head is about a screen tall, so it only starts to fade once
       the calls to action have scrolled past the middle. */
    @media (max-width: 767px) {
      .hero__head { animation-range: exit 35% exit 100%; }
    }
    /* The head fades out a little sooner on tablets and desktops, before the
       panel scrolls up into its place. The panel is never pulled up over the
       head: when the copy runs long it would cover the price line. */
    @supports (animation-timeline: view()) {
      @media (min-width: 768px) and (min-height: 600px) {
        .hero__head { animation-range: exit 0% exit 70%; }
      }
    }
  }
</style>
