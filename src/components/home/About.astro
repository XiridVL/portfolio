---
/**
 * About (#about): a square feature tile (outline monogram over an ember glow,
 * ringed by a slowly orbiting halo) beside the text column: a larger opening
 * paragraph, the facts list, the links and the tools as small cards.
 * On wide, tall screens the tile stays pinned while the text scrolls past.
 */
import SectionHeader from '../SectionHeader.astro';
import Monogram from '../Monogram.astro';
import SocialLinks from './SocialLinks.astro';
import { homeCopy } from '../../i18n/home';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = homeCopy[locale].about;
---

<section id="about" class="section section--deferred" aria-labelledby="about-title">
  <div class="container">
    <SectionHeader id="about" number={copy.number} label={copy.label} title={copy.title} accent={copy.accent} />
    <div class="about">
      <div class="about__visual" aria-hidden="true">
        <div class="about__tile ring-accent sd-parallax">
          <span class="ember about__ember"></span>
          <span class="about__halo"></span>
          <Monogram variant="outline" size={220} knockout="var(--surface)" class="about__mark" />
        </div>
      </div>

      <div class="about__body">
        <div class="about__text">
          {copy.paragraphs.map((p) => <p class="sd-rise">{p}</p>)}
        </div>

        <dl class="about__facts sd-rise">
          {
            copy.facts.map((fact) => (
              <div class="about__fact">
                <dt class="label">{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
          <div class="about__fact about__fact--links">
            <dt class="label">{copy.linksLabel}</dt>
            <dd class="about__links"><SocialLinks locale={locale} /></dd>
          </div>
        </dl>

        <div class="about__tools">
          <h3 class="about__tools-title label sd-rise">{copy.toolsTitle}</h3>
          <dl class="about__tools-list">
            {
              copy.tools.map((row, i) => (
                <div class="about__tool sd-rise" style={`--i: ${i % 2}`}>
                  <dt>{row.area}</dt>
                  <dd>{row.items}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: var(--s-8) var(--s-9);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 960px) {
    .about { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; }
  }

  /* Visual: after the text and smaller on narrow screens, pinned beside it on wide ones. */
  .about__visual { order: 2; width: min(100%, 288px); justify-self: center; }
  @media (min-width: 960px) {
    .about__visual { order: 0; width: 100%; max-width: 480px; }
  }
  @media (min-width: 960px) and (min-height: 700px) {
    .about__visual { position: sticky; top: calc(var(--header-h) + var(--s-7)); }
  }

  .about__tile {
    --px-from: 6%;
    --px-to: -6%;
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-lg);
  }
  .about__ember { width: 90%; inset: 5% auto auto 5%; opacity: .9; }
  .about__halo { position: absolute; inset: 12%; border-radius: 50%; border: 1px solid var(--line); }
  /* A bright arc travels the ring: a crisp 1px line plus a soft glow under it. */
  .about__halo::before,
  .about__halo::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    background: conic-gradient(transparent 55%, rgb(217 160 102 / .9) 88%, var(--ink) 96%, transparent);
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 1.5px), #000 calc(100% - 1px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 1.5px), #000 calc(100% - 1px));
  }
  .about__halo::after {
    inset: -5px;
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 10px), #000);
    mask: radial-gradient(farthest-side, transparent calc(100% - 10px), #000);
    filter: blur(6px);
    opacity: .5;
  }
  .about__tile :global(.about__mark) { position: relative; width: 55%; height: auto; }

  @media (prefers-reduced-motion: no-preference) {
    .about__halo { animation: about-orbit 16s linear infinite; }
    @keyframes about-orbit { to { transform: rotate(1turn); } }
  }

  /* Text column */
  .about__body { display: grid; gap: var(--s-7); min-width: 0; }
  @media (min-width: 960px) {
    .about__body { gap: var(--s-8); }
  }
  .about__text { max-width: var(--measure); }
  .about__text p + p { margin-top: 1.1em; }
  .about__text p:first-child {
    margin-bottom: 1.6em;
    font-size: clamp(var(--step-1), 1rem + 0.6vw, var(--step-2));
    font-weight: 450;
    line-height: 1.5;
    letter-spacing: -0.012em;
    color: var(--ink);
  }

  .about__facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: var(--s-6);
    max-width: var(--measure);
  }
  @media (min-width: 640px) {
    .about__facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .about__fact--links { grid-column: 1 / -1; }
  }
  .about__fact {
    display: grid;
    gap: var(--s-1);
    align-content: start;
    padding-block: var(--s-4);
    border-top: 1px solid var(--line-2);
  }
  .about__fact dt { color: var(--muted); }
  .about__links { margin-top: var(--s-2); }

  .about__tools-title { color: var(--muted); margin-bottom: var(--s-4); }
  .about__tools-list {
    display: grid;
    gap: var(--s-3);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 560px) {
    .about__tools-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .about__tool:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }
  .about__tool {
    display: grid;
    gap: 6px;
    align-content: start;
    padding: var(--s-4) 18px 18px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--surface);
  }
  .about__tool dt { font-weight: 600; font-size: 0.9375rem; letter-spacing: -0.01em; color: var(--ink); }
  .about__tool dd { font-size: var(--step--1); line-height: 1.55; color: var(--muted); }
</style>
