---
/**
 * Sticky glass header. 60px at the top of the page; once 8px have scrolled by
 * it sticks at top: -8px, so the visible bar settles at 52px without any
 * layout change, and a hairline fades in. Monogram lockup left, main nav
 * centred (≥960px), compact language switch + small "Get a quote" pill right
 * (≥640 / ≥768px), mobile menu trigger below 960px.
 *
 * On the home page nav links are in-page anchors (#work); elsewhere they point
 * to the home page of the current locale (/#work, /it/#work).
 */
import Monogram from './Monogram.astro';
import LangSwitch from './LangSwitch.astro';
import MobileMenu from './MobileMenu.astro';
import Button from './Button.astro';
import { localeHref, sectionHref, useStrings, type Anchor, type Locale, type RouteKey } from '../i18n';

interface Props {
  locale: Locale;
  routeKey?: RouteKey;
}
const { locale, routeKey } = Astro.props;
const t = useStrings(locale);
const onHome = routeKey === 'home';

const navAnchors: Array<{ anchor: Anchor; label: string }> = [
  { anchor: 'work', label: t.header.nav.work },
  { anchor: 'services', label: t.header.nav.services },
  { anchor: 'about', label: t.header.nav.about },
  { anchor: 'faq', label: t.header.nav.faq },
  { anchor: 'contact', label: t.header.nav.contact },
];
const navItems = navAnchors.map((item) => ({ ...item, href: sectionHref(item.anchor, locale, onHome) }));
---

<div class="header-sentinel" data-header-sentinel aria-hidden="true"></div>
<header class="site-header" data-header>
  <div class="container site-header__inner ld-fade">
    <a class="site-header__logo" href={localeHref('home', locale)} aria-label={t.header.logoLabel}>
      <Monogram variant="lockup" size={26} />
    </a>

    <nav class="site-header__nav" aria-label={t.header.navLabel}>
      <ul role="list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} data-nav-link={item.anchor}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__tools">
      <LangSwitch locale={locale} routeKey={routeKey} class="site-header__lang" />
      <Button href={sectionHref('contact', locale, onHome)} class="site-header__cta">{t.header.cta}</Button>
      <MobileMenu locale={locale} routeKey={routeKey} items={navItems} ctaHref={sectionHref('contact', locale, onHome)} />
    </div>
  </div>
</header>

<script>
  // header-state: hairline once the page scrolls past the 8px sentinel.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const sentinel = document.querySelector<HTMLElement>('[data-header-sentinel]');
  if (header && sentinel && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      header.classList.toggle('is-scrolled', !entry?.isIntersecting);
    }).observe(sentinel);
  }

  // active-nav: on the home page, mark the nav link (desktop and sheet) of the
  // section holding the middle of the viewport. A thin band around the centre
  // line reports which sections touch it; when two do (their boundary is in the
  // band), the one containing the centre wins, however tall the sections are.
  // Nothing is marked while the centre sits in the hero or an unlisted section.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-nav-link]')).filter((a) =>
    a.getAttribute('href')?.startsWith('#'),
  );
  if (links.length && 'IntersectionObserver' in window) {
    const sections = [...new Set(links.map((a) => a.dataset.navLink ?? ''))]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el);
    const inBand = new Set<Element>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) inBand.add(entry.target);
          else inBand.delete(entry.target);
        }
        const mid = window.innerHeight / 2;
        const touching = sections.filter((s) => inBand.has(s));
        const current = (
          touching.find((s) => {
            const box = s.getBoundingClientRect();
            return box.top <= mid && box.bottom > mid;
          }) ?? touching[0]
        )?.id;
        for (const a of links) a.classList.toggle('is-active', a.dataset.navLink === current);
      },
      { rootMargin: '-48% 0px -48% 0px' },
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>

<style>
  /* The sentinel is exactly as tall as the header shrinks. */
  .header-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: calc(var(--header-h) - var(--header-h-compact));
    pointer-events: none;
  }
  .site-header { position: sticky; top: calc(var(--header-h-compact) - var(--header-h)); z-index: 50; }
  /* Glass on a pseudo-element, so the header never becomes a backdrop root for its children. */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(18 18 18 / .62);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-2);
  }
  .is-scrolled::before { border-bottom-color: var(--line); }

  /* Content sits in the lower 52px, so it is centred in the compact bar. Quicker ld-fade. */
  .site-header__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-4);
    height: var(--header-h);
    padding-top: calc(var(--header-h) - var(--header-h-compact));
    animation-duration: var(--dur-3);
    animation-delay: 80ms;
  }

  .site-header__logo { justify-self: start; display: inline-flex; align-items: center; min-height: 44px; color: var(--ink); text-decoration: none; }
  .site-header__logo:hover { color: var(--ink); opacity: .8; }

  .site-header__nav { display: none; }
  .site-header__nav ul { display: flex; }
  .site-header__nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 14px;
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 520;
    text-decoration: none;
    transition: color var(--dur-1);
  }
  .site-header__nav a:hover,
  .site-header__nav .is-active { color: var(--ink); }
  /* Active section: a 4px clay dot under the label. */
  .site-header__nav a::after {
    content: "";
    position: absolute;
    left: calc(50% - 2px);
    bottom: 3px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0;
    transform: scale(0);
    transition: opacity var(--dur-2), transform var(--dur-2) var(--ease-out);
  }
  .site-header__nav .is-active::after { opacity: 1; transform: none; }

  .site-header__tools { justify-self: end; display: flex; align-items: center; gap: var(--s-2); }
  .site-header__tools :global(.site-header__lang) { display: none; }
  /* A touch smaller than Button md; ::before keeps the hit area at 44px. */
  .site-header__tools :global(.site-header__cta) { display: none; position: relative; min-height: 34px; padding-inline: 16px; font-size: var(--step--1); }
  .site-header__tools :global(.site-header__cta)::before { content: ""; position: absolute; inset: -5px 0; }

  @media (min-width: 640px) {
    .site-header__tools :global(.site-header__lang) { display: inline-flex; }
  }
  @media (min-width: 768px) {
    .site-header__tools :global(.site-header__cta) { display: inline-flex; }
  }
  @media (min-width: 960px) {
    .site-header__inner { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); }
    .site-header__nav { display: block; }
  }
</style>
