---
/**
 * Sticky site header (spec §2.1): 64px, shrinking to 56px with a hairline after
 * 8px of scroll. Monogram lockup, main nav (≥960px), language switch, theme
 * toggle, "Get a quote" CTA (≥768px) and the mobile menu trigger (<960px).
 *
 * On the home page nav links are in-page anchors (#work); elsewhere they point
 * to the home page of the current locale (/#work, /it/#work).
 */
import Monogram from './Monogram.astro';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import MobileMenu from './MobileMenu.astro';
import Button from './Button.astro';
import { localeHref, sectionHref, useStrings, type Anchor, type Locale, type RouteKey } from '../i18n';

interface Props {
  locale: Locale;
  routeKey?: RouteKey;
}
const { locale, routeKey } = Astro.props;
const t = useStrings(locale);
const onHome = routeKey === 'home';

const navAnchors: Array<{ anchor: Anchor; label: string }> = [
  { anchor: 'work', label: t.header.nav.work },
  { anchor: 'services', label: t.header.nav.services },
  { anchor: 'about', label: t.header.nav.about },
  { anchor: 'faq', label: t.header.nav.faq },
  { anchor: 'contact', label: t.header.nav.contact },
];
const navItems = navAnchors.map((item) => ({ ...item, href: sectionHref(item.anchor, locale, onHome) }));
---

<div class="header-sentinel" data-header-sentinel aria-hidden="true"></div>
<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="site-header__logo" href={localeHref('home', locale)} aria-label={t.header.logoLabel}>
      <Monogram variant="lockup" size={28} />
    </a>

    <nav class="site-header__nav" aria-label={t.header.navLabel}>
      <ul role="list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} data-nav-link={item.anchor}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__tools">
      <LangSwitch locale={locale} routeKey={routeKey} class="site-header__lang" />
      <ThemeToggle locale={locale} class="site-header__theme" />
      <Button href={sectionHref('contact', locale, onHome)} class="site-header__cta">{t.header.cta}</Button>
      <MobileMenu locale={locale} routeKey={routeKey} items={navItems} ctaHref={sectionHref('contact', locale, onHome)} />
    </div>
  </div>
</header>

<script>
  // header-state: compact header + hairline once the page scrolls past 8px.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const sentinel = document.querySelector<HTMLElement>('[data-header-sentinel]');
  if (header && sentinel && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      header.classList.toggle('is-scrolled', !entry?.isIntersecting);
    }).observe(sentinel);
  }

  // active-nav: on the home page, mark the nav link of the section in view.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-nav-link]')).filter((a) =>
    a.getAttribute('href')?.startsWith('#'),
  );
  if (links.length && 'IntersectionObserver' in window) {
    const byId = new Map<string, HTMLAnchorElement[]>();
    for (const a of links) {
      const id = a.dataset.navLink!;
      byId.set(id, [...(byId.get(id) ?? []), a]);
    }
    const sections = [...byId.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
    // Sections currently crossing the middle band of the viewport. When none
    // does (e.g. back in the hero), no nav item is marked active.
    const inBand = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) inBand.add(entry.target.id);
          else inBand.delete(entry.target.id);
        }
        const current = sections.find((s) => inBand.has(s.id))?.id;
        for (const a of links) a.classList.toggle('is-active', a.dataset.navLink === current);
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>

<style>
  .header-sentinel { position: absolute; top: 0; left: 0; width: 1px; height: 8px; pointer-events: none; }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(1.2) blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-2) ease, background-color var(--dur-2) ease;
  }
  .site-header.is-scrolled { border-bottom-color: var(--line); }
  .site-header__inner {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: var(--s-4);
    height: var(--header-h);
    transition: height var(--dur-2) var(--ease-tide);
  }
  .site-header.is-scrolled .site-header__inner { height: var(--header-h-compact); }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
    min-width: 0;
  }

  .site-header__nav { display: none; }
  .site-header__nav ul { display: flex; gap: var(--s-1); list-style: none; padding: 0; }
  .site-header__nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--s-3);
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
  }
  .site-header__nav a:hover { color: var(--sea); }
  /* Buoy-dot underline on the active section (spec §8.6.5). */
  .site-header__nav a.is-active::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 4px;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: 50%;
    background: var(--buoy);
  }

  .site-header__tools { display: flex; align-items: center; gap: var(--s-1); min-width: 0; flex-shrink: 0; }
  .site-header__tools :global(.site-header__cta) { display: none; margin-left: var(--s-2); }
  .site-header__tools :global(.site-header__lang), .site-header__tools :global(.site-header__theme) { display: none; }

  @media (min-width: 640px) {
    .site-header__tools :global(.site-header__lang), .site-header__tools :global(.site-header__theme) { display: inline-flex; }
  }
  @media (min-width: 768px) {
    .site-header__tools :global(.site-header__cta) { display: inline-flex; }
  }
  @media (min-width: 960px) {
    .site-header__nav { display: block; }
    .site-header__logo { margin-right: 0; }
    .site-header__nav { margin-inline: auto; }
  }
</style>
