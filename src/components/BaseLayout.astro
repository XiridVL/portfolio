---
/**
 * Page shell: <html lang>, BaseHead, scroll progress bar, skip link, Header,
 * <main id="main">, Footer, MobileCtaBar, and the card-glow pointer script.
 * Locale and route are detected from the URL; pass them
 * explicitly to override.
 *
 *   <BaseLayout title="…" description="…">…sections…</BaseLayout>
 *
 * Slots: default → inside <main>; "head" → extra tags at the end of <head>.
 */
import '../styles/tokens.css';
import '../styles/global.css';
import BaseHead from './BaseHead.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import MobileCtaBar from './MobileCtaBar.astro';
import { localeFromPath, localeMeta, matchRoute, useStrings, type Locale, type RouteKey } from '../i18n';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  /** Defaults to the route matched from the URL; set `null` for pages outside the slug map (404). */
  routeKey?: RouteKey | null;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: unknown;
  /** Hide the sticky mobile CTA bar (e.g. 404). */
  hideMobileCta?: boolean;
  class?: string;
}

const matched = matchRoute(Astro.url.pathname);
const {
  title,
  description,
  locale = matched?.locale ?? localeFromPath(Astro.url.pathname),
  routeKey = matched?.key,
  ogImage,
  ogType,
  noindex,
  jsonLd,
  hideMobileCta = false,
  class: className,
} = Astro.props;
const key = routeKey ?? undefined;
const t = useStrings(locale);
const onHome = key === 'home';
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang} class={className}>
  <head>
    <BaseHead
      locale={locale}
      title={title}
      description={description}
      routeKey={key}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      jsonLd={jsonLd}
    >
      <slot name="head" />
    </BaseHead>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main">{t.skipLink}</a>
    <Header locale={locale} routeKey={key} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} routeKey={key} />
    {!hideMobileCta && <MobileCtaBar locale={locale} onHome={onHome} />}
  </body>
</html>

<script>
  // scroll-fallback: where scroll timelines are missing, BaseHead set .sd-js;
  // play each element's entrance once as it comes into view (global.css).
  if (document.documentElement.classList.contains('sd-js')) {
    (window as Window & { __sdFallback?: boolean }).__sdFallback = true;
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('sd-in');
          io.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    );
    document.querySelectorAll('.sd-rise, .sd-blur, .sd-scale, .sd-tilt, .sd-lit').forEach((el) => io.observe(el));
  }

  // card-glow: keep --mx/--my at the mouse position on [data-glow] elements
  // (read by the .glow-card highlight in global.css). Mouse only; touch has no hover.
  document.addEventListener(
    'pointermove',
    (event) => {
      if (event.pointerType !== 'mouse') return;
      const el = (event.target as Element | null)?.closest<HTMLElement>('[data-glow]');
      if (!el) return;
      const box = el.getBoundingClientRect();
      el.style.setProperty('--mx', `${event.clientX - box.left}px`);
      el.style.setProperty('--my', `${event.clientY - box.top}px`);
    },
    { passive: true },
  );
</script>
