---
/**
 * vStats profile page: browser frame on vstats.xyz, profile block with
 * avatar, abstract hexagon rank chip and sparkline, stat bars, a bell-shaped
 * rank histogram (grey) with the player's bar and marker in clay, a fair-play
 * dial and the five-language row. Static.
 */
import Frame from './Frame.astro';
import type { Locale } from '../../i18n';

interface Props {
  locale?: Locale;
  class?: string;
}
const { locale, class: className } = Astro.props;

const spark = [126, 118, 130, 112, 116, 104, 98].map((y, i) => `${88 + i * 21},${y}`).join(' ');
const stats = [148, 102, 176]
  .map((w, i) => {
    const y = 170 + i * 24;
    return `<rect class="k-iv" x="24" y="${y}" width="208" height="8" rx="4"/><rect class="k-ac" x="24" y="${y}" width="${w}" height="8" rx="4"/>`;
  })
  .join('');
// Grey distribution; the player's own bar (index 7) is the one clay bar.
const bars = [12, 22, 40, 66, 104, 148, 180, 170, 130, 86, 48, 24]
  .map((h, i) => `<rect class="${i === 7 ? 'k-ac' : 'k-iv'}" x="${272 + i * 28}" y="${240 - h}" width="22" height="${h}" rx="3"/>`)
  .join('');
const langs = ['EN', 'PT', 'ES', 'TR', 'JA']
  .map((l, i) => {
    const x = 256 + i * 52;
    return i === 0
      ? `<rect class="k-ac" x="${x}" y="280" width="44" height="26" rx="6"/><text class="k-on mid" x="${x + 22}" y="297">${l}</text>`
      : `<rect class="o-ls" x="${x + 0.5}" y="280.5" width="43" height="25" rx="6"/><text class="mid" x="${x + 22}" y="297">${l}</text>`;
  })
  .join('');

const svg = [
  // Profile: avatar, name bars, rank hexagon, sparkline
  '<circle class="k-s3" cx="52" cy="52" r="26"/>',
  '<rect class="k-ink" x="92" y="36" width="116" height="12" rx="4"/>',
  '<rect class="k-iv" x="92" y="58" width="72" height="9" rx="4"/>',
  '<path class="o-ls hex" d="M52 94l19 11v22l-19 11-19-11v-22z"/>',
  '<text class="k-ink mid" x="52" y="120">III</text>',
  `<polyline class="o-ac sp" points="${spark}"/>`,
  '<circle class="k-ac" cx="214" cy="98" r="3.5"/>',
  stats,
  // Fair-play dial
  '<path class="o-ln dl" d="M84 320a44 44 0 0 1 88 0"/>',
  '<path class="o-ac dl" d="M84 320a44 44 0 0 1 74-32"/>',
  '<path class="nd" d="M128 320l26-26"/>',
  '<circle class="k-ink" cx="128" cy="320" r="4"/>',
  '<text class="mid" x="128" y="350">Fair-play indicator</text>',
  // Histogram panel, baseline and the player's marker
  '<rect class="k-s2 o-ln" x="256.5" y="24.5" width="359" height="235" rx="10"/>',
  '<path class="o-ln" d="M272 240.5h330"/>',
  bars,
  '<path class="o-ac mrk" d="M479 44v22"/>',
  '<circle class="k-sf o-ac" cx="479" cy="40" r="4"/>',
  langs,
  '<rect class="k-iv" x="256" y="330" width="200" height="8" rx="4"/>',
  '<rect class="k-iv" x="256" y="348" width="132" height="8" rx="4"/>',
].join('');
---

<Frame
  class:list={['mk-vstats', className]}
  variant="browser"
  title="vstats.xyz"
  locale={locale}
  label="Illustration of a vStats profile page: stat bars, a rank-distribution histogram, a fair-play indicator dial and a five-language switcher."
>
  <svg viewBox="0 0 640 372" focusable="false" set:html={svg} />
</Frame>

<style is:global>
  .mk-vstats .hex { stroke-width: 1.5; }
  .mk-vstats .sp { stroke-width: 2.5; stroke-linejoin: round; stroke-linecap: round; }
  .mk-vstats .dl { stroke-width: 10; stroke-linecap: round; }
  .mk-vstats .o-ln.dl { stroke: var(--surface-3); }
  .mk-vstats .nd { stroke: var(--ink); stroke-width: 2.5; stroke-linecap: round; }
  .mk-vstats .mrk { stroke-width: 1.5; }
</style>
