---
/**
 * Window frame shared by the mockups: surface body, surface-2 title bar, three
 * neutral grey dots, hairline border, soft deep shadow. The root is the
 * labelled image (role="img" + aria-label); everything inside is hidden from
 * assistive tech.
 *
 * The drawing goes in the default slot (inline SVG; the hero stream panel is
 * HTML so its text stays crisp at any size). SVG drawings use the short utility
 * classes below (k-* fills, o-* outlines) so they follow the tokens:
 * primary data in clay, secondary data in faint ivory, labels muted.
 * `play` marks the frame for its once-on-view micro-state (play.ts).
 */
import type { Locale } from '../../i18n';

interface Props {
  label: string;
  /** Title bar text (window title, address bar or file name). */
  title?: string;
  variant?: 'window' | 'browser' | 'terminal';
  /** CSS aspect-ratio of the whole frame. */
  ratio?: string;
  locale?: Locale;
  play?: boolean;
  class?: string;
}

const { label, title, variant = 'window', ratio = '16 / 10', locale, play = false, class: className } = Astro.props;
---

<div
  class:list={['mk', 'frame', `mk--${variant}`, className]}
  role="img"
  aria-label={label}
  lang={locale === 'it' ? 'en' : undefined}
  data-play={play ? '' : undefined}
  style={`aspect-ratio: ${ratio}`}
>
  <div class="frame__bar mk__bar" aria-hidden="true">
    <span class="frame__dot"></span><span class="frame__dot"></span><span class="frame__dot"></span>
    {title && <span class="mk__title">{title}</span>}
  </div>
  <div class="mk__body" aria-hidden="true"><slot /></div>
</div>

<script>
  import './play';
</script>

<style is:global>
  .mk {
    display: flex;
    flex-direction: column;
    width: 100%;
    box-shadow: var(--shadow-lg);
    container-type: inline-size;
  }
  .mk__bar { flex: none; }
  .mk__title {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-family: var(--font-sans);
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  /* Window and browser titles sit optically centred: end padding (window) or
     an empty end spacer as wide as the dots (browser) balances the dots, and
     flex keeps a narrow address pill from ever running over them. */
  .mk--window .mk__title { margin-inline: auto; padding-inline-end: 44px; }
  .mk--browser .mk__title {
    flex: 0 1 18em;
    margin-inline: auto;
    padding: 1px 12px;
    background: rgb(242 239 232 / .06);
    border-radius: var(--r-pill);
    line-height: 18px;
    text-align: center;
  }
  .mk--browser .mk__bar::after { content: ""; flex: 0 1 39px; }
  .mk--terminal .mk__title { margin-inline-start: 8px; font-family: var(--font-mono); font-weight: 400; }

  .mk__body {
    flex: 1;
    min-height: 0;
    display: grid;
  }
  .mk__body > svg { width: 100%; height: 100%; }

  /* Drawing vocabulary: token colours only. */
  .mk text { font-family: var(--font-sans); font-size: 12px; font-weight: 500; fill: var(--muted); }
  /* o-* outlines come first so a k-* fill on the same element wins. */
  .mk .o-ln { fill: none; stroke: var(--line-2); }
  .mk .o-ls { fill: none; stroke: rgb(242 239 232 / .24); }
  .mk .o-ac { fill: none; stroke: var(--accent); }
  .mk .k-ac { fill: var(--accent); }
  .mk .k-iv { fill: rgb(242 239 232 / .13); }
  .mk .k-s2 { fill: var(--surface-2); }
  .mk .k-s3 { fill: var(--surface-3); }
  .mk .k-sf { fill: var(--surface); }
  .mk .k-ink { fill: var(--ink); }
  .mk .k-on { fill: var(--on-accent); }
  .mk .mid { text-anchor: middle; }
  .mk .end { text-anchor: end; }
  /* The 640-unit card drawings: below ~530px wide their 12-unit labels would
     render under 10px, so show the shapes only (the frame keeps its aria-label). */
  @container (max-width: 529px) {
    .mk .mk__body text { display: none; }
  }
</style>
