---
/**
 * Proof figures: big ivory-to-grey numerals with a caption. Figures are real text.
 *   variant="strip"  home #proof: one centred row split by fading hairlines
 *                    (2 + 2 + 1 on phones, 3 + 2 on tablets, one row from 1024px)
 *   variant="tiles"  case-study "By the numbers": rounded cards in a grid
 * Each figure rises in as it scrolls into view, staggered by position, and is
 * sized to its column (container units) so long figures never overflow.
 * The surrounding <section> and heading belong to the page.
 */
export interface SoundingItem {
  figure: string;
  caption: string;
}
interface Props {
  items: SoundingItem[];
  footnote?: string;
  variant?: 'strip' | 'tiles';
  class?: string;
}
const { items, footnote, variant = 'strip', class: className } = Astro.props;
---

<div class:list={['soundings', `soundings--${variant}`, className]}>
  <ul role="list" class="soundings__list">
    {
      items.map((item, i) => (
        <li class:list={['soundings__item', 'sd-rise', { card: variant === 'tiles' }]} style={`--n: ${i}`}>
          <span class="soundings__figure figure-xl text-gradient">{item.figure}</span>
          <span class="soundings__caption">{item.caption}</span>
        </li>
      ))
    }
  </ul>
  {footnote && <p class="soundings__footnote sd-rise">{footnote}</p>}
</div>

<style>
  .soundings__list { list-style: none; padding: 0; margin: 0; display: grid; }
  .soundings__item {
    --i: calc(var(--n) * .4);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    container-type: inline-size;
  }
  /* Padding keeps the last glyph inside the gradient's paint box. */
  .soundings__figure { white-space: nowrap; padding-inline-end: 0.05em; }
  .soundings__caption { font-size: var(--step--1); line-height: 1.45; color: var(--muted); }
  .soundings__footnote { margin-top: var(--s-7); font-size: 0.8125rem; color: var(--faint); }

  /* strip */
  .soundings--strip { text-align: center; }
  .soundings--strip .soundings__list { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--s-7); }
  .soundings--strip .soundings__item { position: relative; align-items: center; padding-inline: var(--s-4); }
  .soundings--strip .soundings__figure { font-size: min(var(--step-5), 36cqi); }
  .soundings--strip .soundings__caption { max-width: 24ch; text-wrap: balance; }
  /* Column dividers: hairlines that fade at both ends (content set per layout). */
  .soundings--strip .soundings__item::before {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 1px;
    background: linear-gradient(transparent, var(--line-2) 25%, var(--line-2) 75%, transparent);
  }
  @media (max-width: 639px) {
    .soundings--strip .soundings__item:last-child:nth-child(odd) { grid-column: 1 / -1; }
    .soundings--strip .soundings__item:nth-child(even)::before { content: ""; }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .soundings--strip .soundings__list { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .soundings--strip .soundings__item { grid-column: span 2; }
    .soundings--strip .soundings__item:nth-child(n + 4) { grid-column: span 3; }
    .soundings--strip .soundings__item:is(:nth-child(2), :nth-child(3), :nth-child(5))::before { content: ""; }
  }
  @media (min-width: 1024px) {
    .soundings--strip .soundings__list { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); }
    .soundings--strip .soundings__item + .soundings__item::before { content: ""; }
  }

  /* tiles: two columns on phones, three from 640px (four figures stay 2 + 2). */
  .soundings--tiles .soundings__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-3); }
  .soundings--tiles .soundings__item { padding: var(--s-5) var(--s-4); }
  .soundings--tiles .soundings__figure { font-size: min(var(--step-4), 24cqi); }
  @media (min-width: 640px) {
    .soundings--tiles .soundings__list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-4); }
    .soundings--tiles .soundings__list:has(> :last-child:nth-child(4)) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .soundings--tiles .soundings__item { padding: var(--s-6) var(--s-5) var(--s-5); }
  }
</style>
