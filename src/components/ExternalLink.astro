---
/**
 * External link: new tab, rel="noopener", a small ↗ that nudges up and to the
 * right on hover, and a visually hidden "(opens in a new tab)" /
 * "(si apre in una nuova scheda)". The no-break space keeps the glyph on the
 * same line as the last word.
 */
import type { HTMLAttributes } from 'astro/types';
import { useStrings } from '../i18n';
import type { Locale } from '../i18n/locales';

interface Props extends Omit<HTMLAttributes<'a'>, 'target' | 'rel'> {
  href: string;
  locale: Locale;
  /** Hide the ↗ glyph (e.g. icon-only links). */
  noArrow?: boolean;
}
const { href, locale, noArrow = false, class: className, ...rest } = Astro.props;
const t = useStrings(locale);
---

<a href={href} target="_blank" rel="noopener" class:list={['ext-link', className]} {...rest}><slot />{!noArrow && <span aria-hidden="true">&nbsp;<span class="ext-link__arrow">↗</span></span>}<span class="visually-hidden"> {t.externalHint}</span></a>

<style>
  .ext-link__arrow {
    display: inline-block;
    font-size: 0.85em;
    line-height: 1;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .ext-link:hover .ext-link__arrow,
  .ext-link:focus-visible .ext-link__arrow { transform: translate(2px, -2px); }
</style>
