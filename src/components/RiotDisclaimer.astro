---
/**
 * Riot Games trademark disclaimer, verbatim. Small print in --faint, so it
 * belongs on --bg or --surface only.
 *   scope="site"    footer line ("This site and its projects…"); IT pages add the EN line
 *   scope="grid"    small print under the work list (includes the mockups/IVPITER sentences)
 *   scope="project" case-study pages ("This project…"); IT pages add the EN line
 */
import { useStrings, type Locale } from '../i18n';

interface Props {
  scope: 'site' | 'grid' | 'project';
  locale: Locale;
  class?: string;
}
const { scope, locale, class: className } = Astro.props;
const local = useStrings(locale).disclaimer[scope];
const english = useStrings('en').disclaimer[scope];
const addEnglish = locale !== 'en' && scope !== 'grid';
---

<div class:list={['riot-disclaimer', `riot-disclaimer--${scope}`, className]}>
  <p>{local}</p>
  {addEnglish && <p lang="en">{english}</p>}
</div>

<style>
  .riot-disclaimer {
    max-width: var(--measure);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--faint);
  }
  .riot-disclaimer p + p { margin-top: var(--s-1); }
</style>
