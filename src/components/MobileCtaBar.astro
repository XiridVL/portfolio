---
/**
 * Floating mobile CTA bar (<768px only): a glass pill inset 12px from the
 * screen edges, with the primary quote pill and a round mail button. Slides up
 * once the hero (#top) leaves the viewport and hides while #contact or the
 * footer is in view. On pages without a #top hero it appears once the header
 * sentinel scrolls away.
 */
import { site } from '../data/site';
import { sectionHref, useStrings, type Locale } from '../i18n';
import Button from './Button.astro';

interface Props {
  locale: Locale;
  onHome?: boolean;
}
const { locale, onHome = false } = Astro.props;
const t = useStrings(locale);
---

<div class="mobile-cta" data-mobile-cta hidden>
  <Button href={sectionHref('contact', locale, onHome)} arrow="right" class="mobile-cta__quote">{t.mobileCta.quote}</Button>
  <a class="mobile-cta__mail" href={`mailto:${site.email}`} aria-label={t.mobileCta.email}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <rect x="3" y="5.5" width="18" height="13" rx="3" stroke="currentColor" stroke-width="1.5"></rect>
      <path d="M4 7.5l8 5.75 8-5.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </a>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mobile-cta]');
  if (bar && 'IntersectionObserver' in window) {
    const hero = document.getElementById('top') ?? document.querySelector<HTMLElement>('[data-header-sentinel]');
    const contact = document.getElementById('contact');
    const footer = document.querySelector<HTMLElement>('.site-footer');
    let heroVisible = true;
    let contactVisible = false;
    let footerVisible = false;
    const update = () => {
      const show = !heroVisible && !contactVisible && !footerVisible;
      bar.hidden = false;
      bar.classList.toggle('is-visible', show);
      bar.inert = !show;
    };
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.target === hero) heroVisible = entry.isIntersecting;
        if (entry.target === contact) contactVisible = entry.isIntersecting;
        if (entry.target === footer) footerVisible = entry.isIntersecting;
      }
      update();
    });
    if (hero) observer.observe(hero);
    if (contact) observer.observe(contact);
    if (footer) observer.observe(footer);
  }
</script>

<style>
  .mobile-cta {
    position: fixed;
    inset: auto 12px calc(12px + env(safe-area-inset-bottom));
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 6px;
    max-width: 480px;
    margin-inline: auto;
    padding: 6px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-pill);
    background: rgb(34 34 34 / .7);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    transform: translateY(calc(100% + 24px));
    transition: transform var(--dur-3) var(--ease-out), opacity var(--dur-2) ease;
  }
  .mobile-cta.is-visible { opacity: 1; transform: none; }
  .mobile-cta :global(.mobile-cta__quote) { flex: 1; }
  .mobile-cta__mail {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-2);
    border-radius: 50%;
    background: rgb(242 239 232 / .06);
    color: var(--ink);
    transition: background-color var(--dur-1) ease;
  }
  .mobile-cta__mail:hover { background: rgb(242 239 232 / .12); color: var(--ink); }
  @media (min-width: 768px) {
    .mobile-cta { display: none; }
  }
  /* Reserve the floating bar (58px + 12px inset) in scroll padding so a focused control is never scrolled under it (WCAG 2.4.11). */
  @media (max-width: 767px) {
    :global(html) { scroll-padding-bottom: calc(70px + env(safe-area-inset-bottom) + var(--s-4)); }
  }
</style>
