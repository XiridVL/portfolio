---
/**
 * Status chip (spec §8.2). Always carries words; colour is never the only signal.
 *   live     LIVE / ONLINE              ok text on ok-tint, 6px dot
 *   beta     BETA 1.0.0-beta.6          buoy-ink on beta-tint
 *   client   CLIENT WORK                sea text, 1px sea outline
 *   wip      IN DEVELOPMENT & TESTING   muted text, 1px line-strong outline
 *   own      OWN PRODUCT                sea text on surface-2
 *   platform WINDOWS, WINDOWS + SERVER  ink text, 1px line outline
 */
import type { ChipKind } from '../data/projects';

interface Props {
  kind: ChipKind;
  text: string;
  class?: string;
}
const { kind, text, class: className } = Astro.props;
---

<span class:list={['status-chip', `status-chip--${kind}`, className]}>
  {kind === 'live' && <span class="status-chip__dot" aria-hidden="true" />}
  {text}
</span>

<style>
  .status-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 24px;
    padding: 2px 8px;
    border: 1px solid transparent;
    border-radius: var(--r-chip);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.3;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .status-chip__dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; flex: none; }
  .status-chip--live { color: var(--ok); background: var(--ok-tint); }
  .status-chip--beta { color: var(--buoy-ink); background: var(--beta-tint); }
  .status-chip--client { color: var(--sea); border-color: var(--sea); }
  .status-chip--wip { color: var(--muted); border-color: var(--line-strong); }
  .status-chip--own { color: var(--sea); background: var(--surface-2); }
  .status-chip--platform { color: var(--ink); border-color: var(--line-strong); }
</style>
