---
/**
 * Status chip: a small uppercase pill. Always carries words; colour is never
 * the only signal.
 *   live     LIVE / ONLINE              ok text on ok-tint, softly pulsing 6px dot
 *   beta     BETA 1.0.0-beta.6          clay text on accent-tint
 *   client   CLIENT WORK                clay text, clay hairline
 *   wip      IN DEVELOPMENT & TESTING   muted text, line-strong outline
 *   own      OWN PRODUCT                ink text on surface-2
 *   platform WINDOWS, WINDOWS + SERVER  muted text, hairline outline
 */
import type { ChipKind } from '../data/projects';

interface Props {
  kind: ChipKind;
  text: string;
  class?: string;
}
const { kind, text, class: className } = Astro.props;
---

<span class:list={['status-chip', `status-chip--${kind}`, className]}>
  {kind === 'live' && <span class="status-chip__dot" aria-hidden="true" />}
  {text}
</span>

<style>
  .status-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 24px;
    padding: 3px 10px;
    border: 1px solid transparent;
    border-radius: var(--r-pill);
    font-family: var(--font-sans);
    font-size: var(--step--2);
    font-weight: 560;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.3;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .status-chip--live { color: var(--ok); background: var(--ok-tint); }
  .status-chip--beta { color: var(--accent); background: var(--accent-tint); }
  .status-chip--client { color: var(--accent); border-color: rgb(217 160 102 / .45); }
  .status-chip--wip { color: var(--muted); border-color: var(--line-strong); }
  .status-chip--own { color: var(--ink); background: var(--surface-2); }
  .status-chip--platform { color: var(--muted); border-color: var(--line-2); }

  .status-chip__dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    flex: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .status-chip__dot::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: currentColor;
      animation: chip-pulse 2.4s var(--ease-out) infinite;
    }
    @keyframes chip-pulse {
      from { opacity: 0.55; transform: scale(1); }
      70%, to { opacity: 0; transform: scale(2.8); }
    }
  }
</style>
