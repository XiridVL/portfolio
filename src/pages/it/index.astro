---
import BaseLayout from '../../components/BaseLayout.astro';
import Hero from '../../components/home/Hero.astro';
import Proof from '../../components/home/Proof.astro';
import Work from '../../components/home/Work.astro';
import Services from '../../components/home/Services.astro';
import ProcessSteps from '../../components/home/ProcessSteps.astro';
import About from '../../components/home/About.astro';
import Faq from '../../components/home/Faq.astro';
import Contact from '../../components/home/Contact.astro';
import { pageMeta } from '../../data/meta';
import { homeCopy } from '../../i18n/home';
import { homeJsonLd } from '../../lib/seo';
import type { Locale } from '../../i18n';

const locale: Locale = 'it';
const meta = pageMeta.home[locale];
const jsonLd = homeJsonLd(locale, homeCopy[locale].faq.items);
---

<BaseLayout title={meta.title} description={meta.description} locale={locale} routeKey="home" jsonLd={jsonLd}>
  <Hero locale={locale} />
  <Proof locale={locale} />
  <Work locale={locale} />
  <Services locale={locale} />
  <ProcessSteps locale={locale} />
  <About locale={locale} />
  <Faq locale={locale} />
  <Contact locale={locale} />
</BaseLayout>
