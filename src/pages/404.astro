---
/**
 * Bilingual not-found page: English first, an Italian block marked lang="it".
 * Centred composition: a huge italic serif "404" (decorative) over a soft
 * ember glow, the heading, copy and the way home.
 */
import BaseLayout from '../components/BaseLayout.astro';
import Button from '../components/Button.astro';
import { notFoundMeta } from '../data/meta';
import { localeHref } from '../i18n';
---

<BaseLayout
  title={notFoundMeta.title}
  description={notFoundMeta.description}
  locale="en"
  routeKey={null}
  noindex
  hideMobileCta
>
  <section class="not-found section" aria-labelledby="not-found-title">
    <div class="ember ember--drift not-found__ember" aria-hidden="true"></div>

    <div class="container not-found__inner">
      <p class="not-found__code ld-rise" aria-hidden="true"><em class="accent-word">404</em></p>

      <div class="not-found__block">
        <h1 id="not-found-title" class="not-found__title ld-rise" style="--i: 1">Off the chart.</h1>
        <p class="lead ld-rise" style="--i: 2">This page hasn't been sounded yet. The link may be old, or the address mistyped.</p>
        <div class="ld-rise" style="--i: 3">
          <Button href={localeHref('home', 'en')} size="lg" arrow="right">Back to the home page</Button>
        </div>
      </div>

      <div class="not-found__block not-found__block--it ld-rise" style="--i: 4" lang="it">
        <p>
          <strong>Fuori mappa.</strong> Questa pagina non esiste, oppure l'indirizzo è sbagliato.
        </p>
        <Button href={localeHref('home', 'it')} variant="secondary" arrow="right" hreflang="it">Torna alla home</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    isolation: isolate;
    overflow: hidden;
    overflow: clip;
    min-height: calc(100svh - var(--header-h));
    padding-block: var(--s-8);
    display: grid;
    align-content: center;
    text-align: center;
  }
  .not-found__ember {
    inset: 0 0 auto;
    width: min(960px, 140vw);
    margin: -8% auto 0;
    opacity: .9;
  }
  .not-found__inner { display: grid; justify-items: center; }

  .not-found__code {
    font-size: clamp(6rem, 20vw, 14rem);
    line-height: .8;
    letter-spacing: -0.02em;
    margin-bottom: var(--s-5);
  }
  .not-found__code .accent-word { display: inline-block; padding-inline: 0.08em; line-height: 1; }

  .not-found__block { display: grid; gap: var(--s-5); justify-items: center; max-width: 38rem; }
  .not-found__title { font-size: var(--step-4); letter-spacing: -0.035em; }
  .not-found__block .lead { margin-inline: auto; }
  .not-found__block > div { margin-top: var(--s-2); }

  .not-found__block--it {
    gap: var(--s-4);
    margin-top: var(--s-7);
    padding-top: var(--s-6);
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
</style>
