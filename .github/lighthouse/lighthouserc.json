{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["http://localhost/", "http://localhost/it/", "http://localhost/work/vstats/"],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],

        "resource-summary:document:size": ["error", { "maxNumericValue": 46080 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 18432 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 6144 }],
        "resource-summary:font:size": ["error", { "maxNumericValue": 97280 }],
        "resource-summary:image:size": ["error", { "maxNumericValue": 2048 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 174080 }],
        "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }],

        "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.01, "aggregationMethod": "median-run" }],
        "total-blocking-time": ["error", { "maxNumericValue": 100, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
